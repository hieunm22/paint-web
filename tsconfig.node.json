{
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"skipLibCheck": true,
		"strict": true,
		"emitDeclarationOnly": true,
		"outDir": "./node_modules/.tmp/tsconfig.node"
	},
	"include": [
		"vite.config.ts",
		"playwright.config.ts",
		"playwright.offline.config.ts"
	]
}
