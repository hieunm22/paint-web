{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"assets": ["./src/assets"],
			"assets/*": ["./src/assets/*"],
			"common": ["./src/common"],
			"common/*": ["./src/common/*"],
			"components": ["./src/components"],
			"components/*": ["./src/components/*"],
			"engine": ["./src/engine"],
			"engine/*": ["./src/engine/*"],
			"hooks": ["./src/hooks"],
			"hooks/*": ["./src/hooks/*"],
			"locales": ["./src/locales"],
			"locales/*": ["./src/locales/*"],
			"store": ["./src/store"],
			"store/*": ["./src/store/*"],
			"types": ["./src/types"],
			"types/*": ["./src/types/*"]
		}
	},
	"include": ["src"]
}
