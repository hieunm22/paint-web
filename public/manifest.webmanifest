{
	"name": "Canvaslet",
	"short_name": "Canvaslet",
	"description": "An independent browser-based drawing app that runs entirely on your own machine.",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#f0f0f0",
	"theme_color": "#f0f0f0",
	"icons": [
		{
			"src": "/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/icon-maskable.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "maskable"
		}
	],
	"launch_handler": {
		"client_mode": "navigate-existing"
	},
	"file_handlers": [
		{
			"action": "/",
			"accept": {
				"image/png": [".png"],
				"image/jpeg": [".jpg", ".jpeg"],
				"image/bmp": [".bmp", ".dib"],
				"image/gif": [".gif"],
				"image/webp": [".webp"],
				"image/x-icon": [".ico"],
				"image/heic": [".heic"],
				"image/heif": [".heif"]
			}
		}
	]
}
